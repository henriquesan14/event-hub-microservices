# Copie para .env e substitua os valores antes de subir os containers.
POSTGRES_PASSWORD=eventhub_dev_password
RABBITMQ_USER=eventhub
RABBITMQ_PASSWORD=eventhub_dev_password
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
TZ=America/Sao_Paulo

# Integração Asaas sandbox. Deixe a API key vazia se não for testar pagamentos.
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# Entrega de e-mail. Por padrão, os e-mails permanecem no banco.
SMTP_ENABLED=false
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@eventhub.local
