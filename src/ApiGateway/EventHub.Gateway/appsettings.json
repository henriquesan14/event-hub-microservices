{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "PermitLimit": 200,
    "WindowSeconds": 60
  },
  "ReverseProxy": {
    "Routes": {
      "ticketing-event-tickets-exact": {
        "Order": -100,
        "ClusterId": "ticketing",
        "Match": {
          "Path": "/api/events/{eventId}/tickets"
        }
      },
      "ticketing-event-tickets-child": {
        "Order": -100,
        "ClusterId": "ticketing",
        "Match": {
          "Path": "/api/events/{eventId}/tickets/{**remainder}"
        }
      },
      "identity-auth": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/auth/{**remainder}"
        }
      },
      "identity-users": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/users/{**remainder}"
        }
      },
      "events": {
        "Order": 100,
        "ClusterId": "events",
        "Match": {
          "Path": "/api/events/{**remainder}"
        }
      },
      "ticketing-tickets": {
        "ClusterId": "ticketing",
        "Match": {
          "Path": "/api/tickets/{**remainder}"
        }
      },
      "ticketing-reservations": {
        "ClusterId": "ticketing",
        "Match": {
          "Path": "/api/reservations/{**remainder}"
        }
      },
      "orders": {
        "ClusterId": "orders",
        "Match": {
          "Path": "/api/orders/{**remainder}"
        }
      },
      "payments": {
        "ClusterId": "payments",
        "Match": {
          "Path": "/api/payments/{**remainder}"
        }
      },
      "asaas-webhook": {
        "ClusterId": "payments",
        "Match": {
          "Path": "/api/webhooks/asaas"
        }
      },
      "admission": {
        "ClusterId": "admission",
        "Match": {
          "Path": "/api/admission/{**remainder}"
        }
      },
      "notifications": {
        "ClusterId": "notifications",
        "Match": {
          "Path": "/api/notifications/{**remainder}"
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5165/"
          }
        }
      },
      "events": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5228/"
          }
        }
      },
      "ticketing": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:61577/"
          }
        }
      },
      "orders": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:52576/"
          }
        }
      },
      "payments": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:53576/"
          }
        }
      },
      "admission": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:50576/"
          }
        }
      },
      "notifications": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:54576/"
          }
        }
      }
    }
  },
  "ServiceHealth": {
    "identity": "http://localhost:5165/health",
    "events": "http://localhost:5228/health",
    "ticketing": "http://localhost:61577/health",
    "orders": "http://localhost:52576/health",
    "payments": "http://localhost:53576/health",
    "admission": "http://localhost:50576/health",
    "notifications": "http://localhost:54576/health"
  }
}
