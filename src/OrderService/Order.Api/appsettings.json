{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DbConnection": ""
  },
  "Services": {
    "TicketingUrl": "https://localhost:61576"
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "EventHub",
    "Audience": "EventHub.Api",
    "AccessTokenExpirationInMinutes": 50,
    "RefreshTokenExpirationInDays": 7
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*:/api/*",
        "Period": "1m",
        "Limit": 100
      }
    ]
  }
}
