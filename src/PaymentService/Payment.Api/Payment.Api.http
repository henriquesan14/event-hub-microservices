@Payment_Api_HostAddress = https://localhost:63576
@token = paste-token-here
@paymentId = 00000000-0000-0000-0000-000000000000
@orderId = 00000000-0000-0000-0000-000000000000

GET {{Payment_Api_HostAddress}}/api/payments/me
Authorization: Bearer {{token}}

###

GET {{Payment_Api_HostAddress}}/api/payments/{{paymentId}}
Authorization: Bearer {{token}}

###

GET {{Payment_Api_HostAddress}}/api/payments/by-order/{{orderId}}
Authorization: Bearer {{token}}

###

POST {{Payment_Api_HostAddress}}/api/payments/{{paymentId}}/checkout
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Cliente Sandbox",
  "email": "cliente@example.com",
  "cpfCnpj": "12345678909",
  "mobilePhone": "11999999999",
  "billingType": "UNDEFINED"
}

###

POST {{Payment_Api_HostAddress}}/api/webhooks/asaas
asaas-access-token: configure-a-webhook-token-with-at-least-32-characters
Content-Type: application/json

{
  "id": "evt_example",
  "event": "PAYMENT_RECEIVED",
  "payment": {
    "id": "pay_example"
  }
}
